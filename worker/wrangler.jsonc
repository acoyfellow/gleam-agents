{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gleam-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "GRANTS", "class_name": "Grant" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Grant"] }]
}
